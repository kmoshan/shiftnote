{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ShiftNote 主窗口的默认权限集合",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/kmoshan/shiftnote/releases" },
        { "url": "https://github.com/kmoshan/shiftnote/releases/tag/*" }
      ]
    }
  ]
}
